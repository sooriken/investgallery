mixin header
  header.header(id="header")
    .header__container
      // Логотип
      .header__logo-image
        img(src="images-min/logo.png" alt="Логотип" loading="lazy")
      
      // Навигация (десктоп)
      nav.header__nav
        a.header__link(href="#interier" data-i18n="header.nav[0]") Интерьер
        a.header__link(href="#concept" data-i18n="header.nav[1]") Концепция
        a.header__link(href="#provenance" data-i18n="header.nav[2]") Признание
        a.header__link(href="#works" data-i18n="header.nav[3]") Работы
        a.header__link(href="#acquisition" data-i18n="header.nav[4]") Коллекционерам
        a.header__link.js-open-popup(href="#about-popup" data-i18n="header.nav[5]") Об авторе
        a.header__link(href="#feedback" data-i18n="header.nav[6]") Заказ
      
      // Тумблер языка
      .header__lang
        button.header__lang-btn(type="button" data-lang="ru" aria-label="Русский") RU
        span.header__lang-divider /
        button.header__lang-btn(type="button" data-lang="en" aria-label="English") EN
      
      // Кнопка бургера (появляется на мобилках)
      button.header__burger(type="button" aria-label="Открыть меню" aria-expanded="false")
        span.header__burger-line
        span.header__burger-line
        span.header__burger-line

// ===== Мобильное меню (выдвижная панель) =====
.mobile-menu(id="mobileMenu")
  .mobile-menu__overlay
  .mobile-menu__panel
    // Кнопка закрытия
    button.mobile-menu__close(type="button" aria-label="Закрыть меню")
      svg(width="24" height="24" viewBox="0 0 24 24" fill="none")
        path(d="M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round")
        path(d="M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round")
    
    // Логотип в меню
    .mobile-menu__logo
      img(src="images-min/logo.png" alt="Логотип" loading="lazy")
    
    // Ссылки
    nav.mobile-menu__nav
      a.mobile-menu__link(href="#interier" data-i18n="mobile.nav[0]") Интерьер
      a.mobile-menu__link(href="#concept" data-i18n="mobile.nav[1]") Концепция
      a.mobile-menu__link(href="#provenance" data-i18n="mobile.nav[2]") Признание
      a.mobile-menu__link(href="#works" data-i18n="mobile.nav[3]") Работы
      a.mobile-menu__link(href="#acquisition" data-i18n="mobile.nav[4]") Коллекционерам
      a.mobile-menu__link.js-open-popup(href="#about-popup" data-i18n="mobile.nav[5]") Об авторе
      a.mobile-menu__link(href="#feedback" data-i18n="mobile.nav[6]") Заказ
    
    // Контакты в меню
    .mobile-menu__contacts
      a.mobile-menu__contact(href="mailto:info@investme.ru" data-i18n="mobile.contacts[0]") info@investme.ru
      a.mobile-menu__contact(href="https://t.me/investme" data-i18n="mobile.contacts[1]") @investme