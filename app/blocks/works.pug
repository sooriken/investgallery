        .work-card(data-work="ginger1")
          .work-card__image
            img(src="images-min/works/ginger1.jpg" alt="Ginger" loading="lazy")
            //- Overlay с ценами (появляется при ховере)
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label Оригинал
