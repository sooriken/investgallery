          .work-card__info
            span.work-card__series BTC
            span.work-card__desc Цифровое золото
            
        //- Карточка 1
        .work-card.work-card--large(data-work="bull1")
          .work-card__image
            img(src="images-min/works/bull1.jpg" alt="Wall Street Bull" loading="lazy")
            //- Overlay с ценами (появляется при ховере)
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label Архивная галерейная печать + пластификация (способ премиального Оформления снимков, при котором распечатанное изображение помещают между прозрачным акриловым стеклом спереди и прочной алюминиевой панелью сзади). Размер 700х900 мм
                  span.work-card__price-value 180 000 ₽
                //.work-card__price-group
                  span.work-card__price-label Репродукция
                  span.work-card__price-value 50 000 – 100 000 ₽
              a.work-card__button(href="#feedback") Заказать
          .work-card__info
            span.work-card__series Wall Street / Bull
            span.work-card__desc Эстетика рыночного оптимизма
            span.work-card__badge Диптих

