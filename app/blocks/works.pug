//- mixin works
mixin works
  section.works.container(id="works") 
    .works__container
      //- Заголовок секции
      .works__header 
        //.works__icon
          img(src="assets/images/icon.jpg" alt="Bull & Bear" loading="lazy")
        h2.works__title Избранные работы
        p.works__subtitle Каждый объект — результат синтеза смешанной техники и живописи. В основе работ — премиальные материалы: акриловое стекло, металлические конструкции, архивные пигментные чернила.

      //- Сетка работ
      .works__grid
        //- Карточка 5
        .work-card(data-work="benjamin")
          .work-card__image
            img(src="images-min/works/benjamin.jpg" alt="Benjamin" loading="lazy")
            //- Overlay с ценами (появляется при ховере)
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label Оригинал
                  span.work-card__price-value 1 400 000 ₽
                .work-card__price-group
                  span.work-card__price-label Репродукция
                  span.work-card__price-value 35 000 ₽
              a.work-card__button(href="#feedback") Заказать
          .work-card__info
            span.work-card__series Benjamin
            span.work-card__desc Франклин как икона денежного фетишизма
            
        //- Карточка 5
        .work-card(data-work="tulipomania")
          .work-card__image
            img(src="images-min/works/tulipomania.jpg" alt="Tulip Mania" loading="lazy")
            //- Overlay с ценами (появляется при ховере)
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label Оригинал
                  span.work-card__price-value 1 700 000 ₽
                .work-card__price-group
                  span.work-card__price-label Репродукция
                  span.work-card__price-value 25 000 ₽
              a.work-card__button(href="#feedback") Заказать
          .work-card__info
            span.work-card__series Tulip Mania
            span.work-card__desc Деконструкция первой финансовой лихорадки
          
        //- Карточка 5
        .work-card(data-work="astronaut")
          .work-card__image
            img(src="images-min/works/astronaut.jpg" alt="Ginger" loading="lazy")
            //- Overlay с ценами (появляется при ховере)
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label Оригинал
                  span.work-card__price-value 700 000 ₽
                .work-card__price-group
                  span.work-card__price-label Репродукция
                  span.work-card__price-value 38 000 ₽
              a.work-card__button(href="#feedback") Заказать
          .work-card__info
            span.work-card__series Astronaut
            span.work-card__desc Лунный график
            
        //- Карточка 6
        
          
            
        //- Карточка 6
        .work-card(data-work="bitcoin")
          .work-card__image
