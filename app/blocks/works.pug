//- mixin works
mixin works
  section.works.container(id="works") 
    .works__container
      //- Заголовок секции
      .works__header 
        h2.works__title(data-i18n="works.title") Избранные работы
        //- p.works__subtitle(data-i18n="works.subtitle") Каждый объект — результат синтеза смешанной техники и живописи. В основе работ — премиальные материалы: акриловое стекло, металлические конструкции, архивные пигментные чернила.

      //- Сетка работ
      .works__grid
        //- Benjamin
        .work-card(data-work="benjamin")
          .work-card__image
            img(src="images-min/works/benjamin.jpg" alt="Benjamin" loading="lazy")
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.original") Оригинал
                  span.work-card__price-value 1 400 000 ₽
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.reproduction") Репродукция
                  span.work-card__price-value 35 000 ₽
              a.work-card__button(href="#feedback" data-i18n="works.button") Заказать
          .work-card__info
            span.work-card__series(data-i18n="works.series.benjamin") Benjamin
            //- span.work-card__desc(data-i18n="works.desc.benjamin") Франклин как икона денежного фетишизма
            
        //- Tulip Mania
        .work-card(data-work="tulipomania")
          .work-card__image
            img(src="images-min/works/tulipomania.jpg" alt="Tulip Mania" loading="lazy")
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.original") Оригинал
                  span.work-card__price-value 1 700 000 ₽
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.reproduction") Репродукция
                  span.work-card__price-value 25 000 ₽
              a.work-card__button(href="#feedback" data-i18n="works.button") Заказать
          .work-card__info
            span.work-card__series(data-i18n="works.series.tulipomania") Tulip Mania
            //- span.work-card__desc(data-i18n="works.desc.tulipomania") Деконструкция первой финансовой лихорадки
          
        //- Astronaut
        .work-card(data-work="astronaut")
          .work-card__image
            img(src="images-min/works/astronaut.jpg" alt="Ginger" loading="lazy")
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.original") Оригинал
                  span.work-card__price-value 700 000 ₽
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.reproduction") Репродукция
                  span.work-card__price-value 38 000 ₽
              a.work-card__button(href="#feedback" data-i18n="works.button") Заказать
          .work-card__info
            span.work-card__series(data-i18n="works.series.astronaut") Astronaut
            //- span.work-card__desc(data-i18n="works.desc.astronaut") Лунный график
          
        //- BTC
        .work-card(data-work="bitcoin")
          .work-card__image
            img(src="images-min/works/bitcoin-2.jpg" alt="Ginger" loading="lazy")
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.original") Оригинал
                  span.work-card__price-value 700 000 ₽
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.reproduction") Репродукция
                  span.work-card__price-value 25 000 ₽
              a.work-card__button(href="#feedback" data-i18n="works.button") Заказать
          .work-card__info
            span.work-card__series(data-i18n="works.series.bitcoin") BTC
            //- span.work-card__desc(data-i18n="works.desc.bitcoin") Цифровое золото
          
        //- Wall Street / Bull
        .work-card.work-card--large(data-work="bull1")
          .work-card__image
            img(src="images-min/works/bull1.jpg" alt="Wall Street Bull" loading="lazy")
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.price_labels.archival") Архивная галерейная печать + пластификация (способ премиального оформления снимков, при котором распечатанное изображение помещают между прозрачным акриловым стеклом спереди и прочной алюминиевой панелью сзади). Размер 700х900 мм
                  span.work-card__price-value 180 000 ₽
              a.work-card__button(href="#feedback" data-i18n="works.button") Заказать
          .work-card__info
            span.work-card__series(data-i18n="works.series.bull1") Wall Street / Bull
            //- span.work-card__desc(data-i18n="works.desc.bull1") Эстетика рыночного оптимизма
            span.work-card__badge(data-i18n="works.badge") Диптих

        //- Wall Street / Bull 2
        .work-card.work-card--large(data-work="bull2")
          .work-card__image
            img(src="images-min/works/bull2.jpg" alt="Wall Street Bull" loading="lazy")
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.price_labels.archival") Архивная галерейная печать + пластификация (способ премиального оформления снимков, при котором распечатанное изображение помещают между прозрачным акриловым стеклом спереди и прочной алюминиевой панелью сзади). Размер 700х900 мм
                  span.work-card__price-value 180 000 ₽
              a.work-card__button(href="#feedback" data-i18n="works.button") Заказать
          .work-card__info
            span.work-card__series(data-i18n="works.series.bull2") Wall Street / Bull 2
            //- span.work-card__desc(data-i18n="works.desc.bull2") Эстетика рыночного оптимизма
            span.work-card__badge(data-i18n="works.badge") Диптих

        //- Wallstreetbets
        .work-card.work-card--large(data-work="wallstreetbets") 
          .work-card__image
            img(src="images-min/works/wallstreetbets.jpg" alt="Wallstreetbets" loading="lazy")
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.original") Оригинал
                  span.work-card__price-value 450 000 ₽
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.reproduction") Репродукция
                  span.work-card__price-value 25 000 ₽
              a.work-card__button(href="#feedback" data-i18n="works.button") Заказать
          .work-card__info
            span.work-card__series(data-i18n="works.series.wallstreetbets") Wallstreetbets
            //- span.work-card__desc(data-i18n="works.desc.wallstreetbets") Отражение новой эры крипторынка

        //- Wallstreetbets 2
        .work-card.work-card--large(data-work="wallstreetbets") 
          .work-card__image
            img(src="images-min/works/wallstreetbets2.jpg" alt="Wallstreetbets" loading="lazy")
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.original") Оригинал
                  span.work-card__price-value 450 000 ₽
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.reproduction") Репродукция
                  span.work-card__price-value 25 000 ₽
              a.work-card__button(href="#feedback" data-i18n="works.button") Заказать
          .work-card__info
            span.work-card__series(data-i18n="works.series.wallstreetbets") Wallstreetbets
            //- span.work-card__desc(data-i18n="works.desc.wallstreetbets") Отражение новой эры крипторынка

        //- Great Depression
        .work-card(data-work="depression")
          .work-card__image
            img(src="images-min/works/depression.jpg" alt="depression" loading="lazy")
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.original") Оригинал
                  span.work-card__price-value 1 200 000 ₽
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.reproduction") Репродукция
                  span.work-card__price-value 25 000 ₽
              a.work-card__button(href="#feedback" data-i18n="works.button") Заказать
          .work-card__info
            span.work-card__series(data-i18n="works.series.depression") Great Depression. Beginning
            //- span.work-card__desc(data-i18n="works.desc.depression") Великая депрессия

        //- J Coin
        .work-card(data-work="jcoin")
          .work-card__image
            img(src="images-min/works/jcoin.jpg" alt="jcoin" loading="lazy")
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.original") Оригинал
                  span.work-card__price-value 500 000 ₽
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.reproduction") Репродукция
                  span.work-card__price-value 25 000 ₽
              a.work-card__button(href="#feedback" data-i18n="works.button") Заказать
          .work-card__info
            span.work-card__series(data-i18n="works.series.jcoin") J Coin
            //- span.work-card__desc(data-i18n="works.desc.jcoin") Джи Коин

        //- Ginger 1
        .work-card(data-work="ginger1")
          .work-card__image
            img(src="images-min/works/ginger1.jpg" alt="Ginger" loading="lazy")
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.original") Оригинал
                  span.work-card__price-value 400 000 ₽
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.reproduction") Репродукция
                  span.work-card__price-value 15 000 ₽
              a.work-card__button(href="#feedback" data-i18n="works.button") Заказать
          .work-card__info
            span.work-card__series(data-i18n="works.series.ginger1") Ginger 1
            //- span.work-card__desc(data-i18n="works.desc.ginger1") Анатомия спекулятивного ажиотажа
            span.work-card__badge(data-i18n="works.badge") Диптих

        //- Ginger 2
        .work-card(data-work="ginger2")
          .work-card__image
            img(src="images-min/works/ginger2.jpg" alt="Ginger" loading="lazy")
            .work-card__overlay
              .work-card__prices
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.original") Оригинал
                  span.work-card__price-value 400 000 ₽
                .work-card__price-group
                  span.work-card__price-label(data-i18n="works.reproduction") Репродукция
                  span.work-card__price-value 15 000 ₽
              a.work-card__button(href="#feedback" data-i18n="works.button") Заказать
          .work-card__info
            span.work-card__series(data-i18n="works.series.ginger2") Ginger 2
            //- span.work-card__desc(data-i18n="works.desc.ginger2") Волатильность как скрытая структура
            span.work-card__badge(data-i18n="works.badge") Диптих

      //- Техническая заметка
      .works__materials
        .works__materials-line
        p.works__materials-text(data-i18n="works.materials") *Цена на репродукции зависит от её размера.